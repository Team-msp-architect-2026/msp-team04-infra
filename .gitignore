# Local .terraform directories
.terraform/

# Terraform lock/cache files
.terraform.tfstate.lock.info

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable files
*.tfvars
*.tfvars.json

# Allow example variable files
!*.tfvars.example

# Terraform crash log files
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan output files
tfplan*
*.tfplan

# Terraform CLI configuration files
.terraformrc
terraform.rc

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Environment files
.env
.env.*
!.env.example

# Certificates / keys
*.pem
*.key

# Python cache
__pycache__/
*.pyc

# Terraform generated Lambda package
terraform/modules/data-pipeline/*.zip
